{
  "name": "nox-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Nox, a cross-platform desktop Transformer companion.",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "export:mesh": "node scripts/export-nox-mesh.mjs",
    "check:mesh": "node scripts/check-nox-mesh.mjs",
    "package:mac": "electron-builder --mac dmg zip",
    "package:win": "electron-builder --win nsis zip"
  },
  "devDependencies": {
    "electron": "^39.8.10",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "three": "^0.182.0"
  },
  "build": {
    "appId": "com.igorvomero.nox",
    "productName": "Nox",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": ["dmg", "zip"]
    },
    "win": {
      "target": ["nsis", "zip"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
